{
  "name": "nx_dashboard",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:backend": "cargo build --release --bin nx_api --manifest-path ../Cargo.toml",
    "build:backend:dev": "cargo build --bin nx_api --manifest-path ../Cargo.toml",
    "build:all": "npm run build && npm run build:backend",
    "prepare:sidecar": "node -e \"const fs=require('fs');const p='src-tauri/binaries';fs.mkdirSync(p,{recursive:true});const t=require('os').arch()==='arm64'?'aarch64-apple-darwin':'x86_64-apple-darwin';const f=p+'/nx_api-'+t;if(!fs.existsSync(f)){fs.writeFileSync(f,'');fs.chmodSync(f,0o755);}\"",
    "copy:sidecar": "node -e \"const fs=require('fs');const p='src-tauri/binaries';fs.mkdirSync(p,{recursive:true});const t=require('os').arch()==='arm64'?'aarch64-apple-darwin':'x86_64-apple-darwin';const src='../target/release/nx_api';const dst=p+'/nx_api-'+t;if(!fs.existsSync(src)){console.error('Backend binary not found: '+src);process.exit(1);}fs.copyFileSync(src,dst);fs.chmodSync(dst,0o755);console.log('Copied '+src+' -> '+dst);\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:af-p1": "node ../scripts/e2e-af-p1.mjs",
    "test:e2e:golden-path": "node ../scripts/e2e-golden-path.mjs",
    "test:dogfood:af-p5": "node ../scripts/dogfood-af-p5.mjs",
    "metrics:export": "node ../scripts/export-factory-metrics.mjs",
    "ef:check": "node ../scripts/enterprise-ef-check.mjs",
    "ef:check:report": "node ../scripts/enterprise-ef-check.mjs --report",
    "tauri": "tauri",
    "tauri:dev": "npm run prepare:sidecar && npm run build:backend:dev && tauri dev",
    "tauri:build": "npm run build:backend && npm run copy:sidecar && tauri build",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,json}'"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "endOfLine": "lf"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.59.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@types/js-yaml": "^4.0.9",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.10.0",
    "allotment": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.454.0",
    "motion": "^12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^4.1.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.49",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.4"
  }
}
